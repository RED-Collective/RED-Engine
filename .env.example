# RED Engine — Environment Variable Reference
# Copy this file to .env and fill in your values.
#
# Usage:
#   cp .env.example .env
#   # then edit .env with your values
#   docker compose up -d
#
# All variables are optional. The node starts with sensible defaults
# or falls back to config.json values.

# ── Node Identity ───────────────────────────────────────────────
# RED_NODE_NAME=my-node
# Permanent identity shown in the peer list. Changing this after
# peers have connected will break those connections.

# RED_NODE_DESCRIPTION=
# Free-text description shown in nodeinfo. Optional.

# ── Admin Access ────────────────────────────────────────────────
# RED_ADMIN_TOKEN=
# 48-char random token for the admin panel. If not set, the node
# starts in read-only lockdown (content served, admin disabled).
# Generate one: openssl rand -hex 24

# ── Network ─────────────────────────────────────────────────────
# RED_ADDR=:8080
# Listen address and port.

# RED_PUBLIC_URL=
# Externally reachable URL (e.g. https://mynode.example.com).
# Required for federation behind NAT.

# RED_TUNNEL_TYPE=direct
# One of: direct, cloudflare_quick, cloudflare_named
# Set to "cloudflare_quick" to auto-announce quick-tunnel URLs.

# ── Storage ─────────────────────────────────────────────────────
# RED_DATA_DIR=data
# Directory for content files (articles, images).

# RED_STATE_DIR=state
# Directory for private state (node key, registry.db).
# Auto-generated on first boot.

# ── GitHub Webhook ──────────────────────────────────────────────
# RED_WEBHOOK_SECRET=
# HMAC secret for GitHub push webhooks. Optional.

# ── CORS ────────────────────────────────────────────────────────
# RED_CORS_ORIGINS=
# Comma-separated origins to allow CORS from.

# ── Dev / Testing ───────────────────────────────────────────────
# RED_ALLOW_PRIVATE_SYNC=true
# Allow syncing from loopback/LAN addresses (dev only).
# NEVER enable this in production.

# ── Frontend ────────────────────────────────────────────────────
# RED_WEB_DIR=FRONTEND_BUILD
# Directory containing the compiled React SPA.
